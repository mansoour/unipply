{
  "manifest_version": 3,
  "name": "Unipply",
  "version": "0.1.0",
  "description": "AI-assisted autofill for university admission application forms, using your own saved profile and Gemini API key.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Unipply",
    "default_icon": {
      "16": "assets/action/action16.png",
      "24": "assets/action/action24.png",
      "32": "assets/action/action32.png"
    }
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
