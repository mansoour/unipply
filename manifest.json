{
  "manifest_version": 3,
  "name": "Uni Application Autofill",
  "version": "0.1.0",
  "description": "AI-assisted autofill for university admission application forms, using your own saved profile and Gemini API key.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Uni Application Autofill"
  },
  "options_page": "src/options/options.html"
}
